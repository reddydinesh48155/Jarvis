# PostgreSQL
POSTGRES_DB=nova
POSTGRES_USER=nova
POSTGRES_PASSWORD=change-me-postgres-password

# Backend database URL. Use the Docker service name "postgres" for Compose.
DATABASE_URL=postgresql+asyncpg://nova:change-me-postgres-password@postgres:5432/nova

# Authentication
# Generate a unique random value of at least 32 characters for any non-local environment.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token

# Cookies and CORS
# Keep false for local HTTP. Set true when serving over HTTPS.
SECURE_COOKIES=false
COOKIE_SAMESITE=lax
FRONTEND_ORIGIN=http://localhost:3000
ENVIRONMENT=development

# Frontend browser-side API origin
NEXT_PUBLIC_API_URL=http://localhost:8000

# LiveKit Cloud
# Use the WebSocket URL shown by your LiveKit Cloud project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-your-livekit-api-key
LIVEKIT_API_SECRET=replace-with-your-livekit-api-secret
LIVEKIT_AGENT_NAME=nova-voice
LIVEKIT_TOKEN_TTL_SECONDS=3600
